# Gemini OCR (production — set MOCK_OCR=false)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local FE demo — sample OCR data, no external API (100% free)
MOCK_OCR=false

# Auth — required in production (server cookie auth fallback)
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AWS Cognito (email/password SPA login — preferred for CloudFront static FE)
NEXT_PUBLIC_COGNITO_REGION=ap-northeast-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Required for /users/ admin (list, add, delete) — see docs/COGNITO.md
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=

# Google Sheets export — server-side credentials (users never sign in to Google)
# Preferred: stored OAuth refresh token for the account that owns the root
# folder — uploaded files get a real owner + storage quota.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Fallback: service account (needs a Shared Drive root — SAs have no quota).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Or the full JSON key in one var: GOOGLE_SERVICE_ACCOUNT_JSON='{...}'
# Fixed root Drive folder — share it with the service account email (Editor).
# Every survey exports under this folder; the user only enters the project name.
# If unset, the app finds or creates a folder named JBC-COWELL in the
# service account's own Drive (not visible to users — set this in production).
GOOGLE_SHEETS_FOLDER_ID=
NEXT_PUBLIC_GOOGLE_SHEETS_FOLDER_ID=
# Optional: comma-separated emails granted writer access to the fixed root —
# needed when the root lives in the service account's own Drive (otherwise
# users can't open exported folders in Drive UI).
GOOGLE_DRIVE_SHARE_WITH=

# App
NEXT_PUBLIC_APP_NAME=COWELL OCR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend OCR API (Lambda). Keep URL set, but enable only when Gemini is stable.
NEXT_PUBLIC_OCR_API_BASE_URL=https://4gzkbzzubqjzwcx7mf3xcjpb7i0rdssf.lambda-url.ap-northeast-1.on.aws
NEXT_PUBLIC_OCR_API_ENABLED=true

# Sheets export API (Lambda Function URL) — required on static hosts
# (S3 + CloudFront / GitHub Pages) where /api/* does not exist.
# Leave empty for server hosting (uses same-origin /api/sheets/*).
NEXT_PUBLIC_SHEETS_API_BASE_URL=

# ⚠️ INSECURE fallback for static hosts with no backend at all: embeds a
# Google refresh token in the public JS bundle — anyone can extract it.
# If you must use it: dedicated bot Google account owning ONLY the export
# root, drive+spreadsheets scopes, rotate the token periodically.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_DRIVE_REFRESH_TOKEN=
# Emails granted writer access on the fixed root (bot-owned root case).
NEXT_PUBLIC_GOOGLE_DRIVE_SHARE_WITH=

# Local dev only (never enable in production)
NEXT_PUBLIC_DEV_AUTO_LOGIN=false
NEXT_PUBLIC_DEV_LOGIN_EMAIL=
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=
